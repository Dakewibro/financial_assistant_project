# Option 3a (Vercel production): leave VITE_BACKEND_URL unset so the app calls
# same-origin /api/* and frontend/vercel.json rewrites those requests to your
# backend deployment. Edit vercel.json "destination" to:
#   https://<your-backend-project>.vercel.app/api/:path*
# Option 3b: set VITE_BACKEND_URL to the full backend origin (no trailing slash)
# and remove or change the /api rewrite so you do not double-prefix /api.

# Local dev: point at your machine (or leave default and use vite proxy below).
VITE_BACKEND_URL=http://localhost:4000

# Upstream used by the Vite dev server proxy for /api/*
VITE_DEV_API_PROXY_TARGET=http://localhost:4000
